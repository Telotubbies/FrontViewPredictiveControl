apiVersion: 1
datasources:
  - name: InfluxDB
    type: influxdb
    access: proxy
    url: http://influxdb:8086
    isDefault: true
    jsonData:
      version: Flux
      organization: adas
      defaultBucket: adas_telemetry
      tlsSkipVerify: true
    secureJsonData:
      token: adas-token-1234567890abcdef
