def make_test_config() -> TJAConfig:
    """Config with short timings for fast testing."""
    return TJAConfig(
        activate_speed_ms=8.33,
        deactivate_speed_ms=12.0,
        min_follow_distance_m=3.0,
        time_gap_s=1.2,
        stop_hold_time_s=2.0,   # short for testing
        creep_speed_ms=1.0,
        stop_brake=0.3,
        creep_throttle=0.15,
    )


